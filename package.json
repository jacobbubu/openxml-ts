  "size-limit": [
    {
      "name": "openxml-ts (root entry, OPC + ZIP backend)",
      "path": "dist/index.js",
      "limit": "100 KB",
      "gzip": true
    },
    {
      "name": "openxml-ts/validation (validator engine, no constraint data)",
      "path": "dist/validation/index.js",
      "import": "{ OpenXmlValidator }",
      "limit": "50 KB",
      "gzip": true
    },
    {
      "name": "openxml-ts/word minimal (Paragraph + Run + Text)",
      "path": "dist/word/generated/paragraph.js",
      "import": "{ Paragraph }",
      "limit": "50 KB",
      "gzip": true
