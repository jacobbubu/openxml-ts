{
  "name": "openxml-ts",
  "version": "0.5.0",
  "description": "TypeScript port of Microsoft Open-XML-SDK; pnpm-managed, Bun-first, Node>=20 ESM",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./word": {
      "types": "./dist/word/index.d.ts",
      "import": "./dist/word/index.js"
    },
    "./word/generated/*": {
      "types": "./dist/word/generated/*.d.ts",
      "import": "./dist/word/generated/*.js"
    },
    "./excel": {
      "types": "./dist/excel/index.d.ts",
      "import": "./dist/excel/index.js"
    },
    "./excel/generated/*": {
      "types": "./dist/excel/generated/*.d.ts",
      "import": "./dist/excel/generated/*.js"
    },
    "./ppt": {
      "types": "./dist/ppt/index.d.ts",
      "import": "./dist/ppt/index.js"
    },
    "./ppt/generated/*": {
      "types": "./dist/ppt/generated/*.d.ts",
      "import": "./dist/ppt/generated/*.js"
    },
    "./drawing": {
      "types": "./dist/drawing/index.d.ts",
      "import": "./dist/drawing/index.js"
    },
    "./drawing/generated/*": {
      "types": "./dist/drawing/generated/*.d.ts",
      "import": "./dist/drawing/generated/*.js"
    },
    "./linq": {
      "types": "./dist/linq/index.d.ts",
      "import": "./dist/linq/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20",
    "bun": ">=1.1"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "tsc --build",
    "clean": "tsc --build --clean && rm -rf dist",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "test:browser:install": "playwright install chromium",
    "bench": "vitest bench --run",
    "golden:gen": "bun run tools/golden-generator/generate.ts",
    "gen:word": "bun run tools/schema-codegen/generate.ts",
    "gen:excel": "bun run tools/schema-codegen/generate.ts --input ../../github/Open-XML-SDK/data/schemas/schemas_openxmlformats_org_spreadsheetml_2006_main.json --output src/excel/generated",
    "gen:drawing": "bun run tools/schema-codegen/generate.ts --input ../../github/Open-XML-SDK/data/schemas/schemas_openxmlformats_org_drawingml_2006_main.json --output src/drawing/generated",
    "gen:ppt": "bun run tools/schema-codegen/generate.ts --input ../../github/Open-XML-SDK/data/schemas/schemas_openxmlformats_org_presentationml_2006_main.json --output src/ppt/generated",
    "format": "biome format --write .",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "size": "size-limit",
    "size:why": "size-limit --why"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@size-limit/esbuild-why": "^12.1.0",
    "@size-limit/preset-small-lib": "^12.1.0",
    "@types/node": "^22.10.5",
    "@vitest/browser": "^2.1.9",
    "@vitest/coverage-v8": "^2.1.9",
    "bmad-method": "^6.6.0",
    "playwright": "^1.60.0",
    "size-limit": "^12.1.0",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jacobbubu/openxml-ts.git"
  },
  "homepage": "https://github.com/jacobbubu/openxml-ts#readme",
  "bugs": {
    "url": "https://github.com/jacobbubu/openxml-ts/issues"
  },
  "keywords": [
    "openxml",
    "ooxml",
    "docx",
    "xlsx",
    "pptx",
    "iso-29500",
    "opc",
    "office",
    "typescript",
    "bun",
    "esm"
  ],
  "dependencies": {
    "@zip.js/zip.js": "^2.8.26"
  },
  "size-limit": [
    {
      "name": "openxml-ts (root entry, OPC + ZIP backend)",
      "path": "dist/index.js",
      "limit": "100 KB",
      "gzip": true
    },
    {
      "name": "openxml-ts/word minimal (Paragraph + Run + Text)",
      "path": "dist/word/generated/paragraph.js",
      "import": "{ Paragraph }",
      "limit": "50 KB",
      "gzip": true
    },
    {
      "name": "openxml-ts/word (full bundle including registry)",
      "path": "dist/word/index.js",
      "limit": "500 KB",
      "gzip": true
    },
    {
      "name": "openxml-ts/excel minimal (Cell + Row + Worksheet)",
      "path": "dist/excel/index.js",
      "import": "{ Cell, Row, Worksheet }",
      "limit": "50 KB",
      "gzip": true
    },
    {
      "name": "openxml-ts/excel (full bundle including registry)",
      "path": "dist/excel/index.js",
      "limit": "600 KB",
      "gzip": true
    },
    {
      "name": "openxml-ts/ppt minimal (Slide + Shape + TextBody + Paragraph)",
      "path": [
        "dist/ppt/generated/slide.js",
        "dist/ppt/generated/shape.js",
        "dist/ppt/generated/text-body.js",
        "dist/drawing/generated/paragraph.js"
      ],
      "limit": "80 KB",
      "gzip": true
    },
    {
      "name": "openxml-ts/ppt (full bundle including registry)",
      "path": "dist/ppt/index.js",
      "limit": "800 KB",
      "gzip": true
    },
    {
      "name": "openxml-ts/drawing (full bundle including registry)",
      "path": "dist/drawing/index.js",
      "limit": "400 KB",
      "gzip": true
    }
  ]
}
